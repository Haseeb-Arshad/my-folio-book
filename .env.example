# Server-only configuration for the portfolio conversation.
# Never put these keys in client code or commit real values.
PORTFOLIO_OPENROUTER_API_KEY=
PORTFOLIO_OPENROUTER_MODEL=openai/gpt-4.1-mini
PORTFOLIO_SITE_URL=https://haseebarshad.me

# Client-exposed PostHog write-only project token. It is safe in the browser,
# but keep the value in deployment environment settings rather than source.
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_API_HOST=https://us.i.posthog.com

# Supabase. The site reads content server-side with the secret key, which
# bypasses RLS, so it must never reach the browser. The publishable key is
# not used at runtime today and is kept only for future client-side features.
#
# Content tables have RLS enabled and forced with no anon policies, so the
# publishable key cannot read them even if the Data API exposes the schema.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Only needed to run `npm run db:migrate` and `npm run db:seed`.
# Either the database password, or a full SUPABASE_DB_URL that overrides it.
SUPABASE_DB_PASSWORD=
# SUPABASE_DB_URL=postgresql://postgres:...@db.<ref>.supabase.co:5432/postgres
